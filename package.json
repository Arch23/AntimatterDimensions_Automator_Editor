{
  "name": "antimatter-dimensions-automator-tools",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "test": "corepack pnpm --filter @adme/automator-language --filter @adme/web-editor test",
    "test:e2e": "corepack pnpm --filter @adme/web-editor test:e2e",
    "package:vscode": "corepack pnpm --filter antimatter-dimensions-automator package",
    "security:check": "node scripts/security/check.mjs",
    "security:staged": "node scripts/security/check.mjs --staged",
    "security:test": "node scripts/security/test-harness.mjs",
    "security:install-hooks": "node scripts/security/install-hooks.mjs"
  }
}
